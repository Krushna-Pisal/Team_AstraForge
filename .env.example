# ==============================================================================
# AstraForge Environment Configuration Template
# NOTE: Copy this file to .env and replace placeholders with real values.
# NEVER commit or expose actual keys, secrets, or service credentials.
# ==============================================================================

# --- Application Environment ---
# Options: development | staging | production
ENVIRONMENT=development
ALLOW_DEV_AUTH_BYPASS=false

# --- Supabase Authentication (Backend JWT Verification) ---
# Project Settings -> API -> JWT Settings -> JWT Secret (must be at least 32 chars)
SUPABASE_JWT_SECRET=your_32_character_supabase_jwt_secret_here

# --- Frontend Application & CORS Configuration ---
# Production URL of the frontend web application allowed to make API calls
FRONTEND_URL=https://app.yourdomain.com
# Optional comma-separated list of additional allowed CORS origins
ALLOWED_ORIGINS=https://app.yourdomain.com,https://staging.yourdomain.com

# --- Google Gemini AI (Optional Grounded Explanations) ---
# If omitted or left as placeholder, deterministic validated explanations are used.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
