# ==============================================================================
# AstraForge Frontend Environment Configuration Template
# Copy this file to frontend/.env for production or staging deployments.
# ==============================================================================

# --- Supabase Authentication ---
# Project Settings -> API -> Project URL & Project API Key (anon/public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Backend API Target (Production Deployments) ---
# When frontend is hosted separately from backend (e.g. Vercel, Netlify, Cloudflare),
# set this to the backend API origin. Leave empty in local development to use the Vite proxy.
VITE_API_BASE_URL=https://api.yourdomain.com
